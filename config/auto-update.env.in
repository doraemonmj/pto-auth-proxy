# Local, root-owned adapter configuration for the reusable repo_auto_update
# module. Preserve this file across application updates.
REPO_AUTO_UPDATE_NAME=pto-auth-proxy
REPO_AUTO_UPDATE_REPOSITORY=https://github.com/pypto-tools/pto-auth-proxy.git
REPO_AUTO_UPDATE_BRANCH=main
REPO_AUTO_UPDATE_MANIFEST=update/rollout.json
REPO_AUTO_UPDATE_STATE_DIR=@TOOL_DIR@/update
REPO_AUTO_UPDATE_TMP_DIR=@TOOL_DIR@/tmp
REPO_AUTO_UPDATE_TEST_USER=@PROXY_USER@
# Share the administrator-owned upstream config; never keep a separate port.
_auth_config=@TOOL_DIR@/config/auth-proxy.env
[[ -f "$_auth_config" && ! -L "$_auth_config" &&
   $(stat -c %u "$_auth_config") == 0 &&
   $((8#$(stat -c %a "$_auth_config") & 8#022)) == 0 ]] || {
    echo "unsafe auth-proxy configuration for updater" >&2
    return 1
}
# shellcheck source=/dev/null
source "$_auth_config"
: "${PTO_AUTH_PROXY_UPSTREAM_PORT:?configure the SOCKS5 upstream port in auth-proxy.env}"
[[ "$PTO_AUTH_PROXY_UPSTREAM_PORT" =~ ^[0-9]+$ ]] &&
    ((10#$PTO_AUTH_PROXY_UPSTREAM_PORT >= 1 && 10#$PTO_AUTH_PROXY_UPSTREAM_PORT <= 65535)) || {
    echo "invalid auth-proxy upstream port for updater" >&2
    return 1
}
_fetch_host=${PTO_AUTH_PROXY_UPSTREAM_HOST:-127.0.0.1}
[[ "$_fetch_host" != *:* ]] || _fetch_host="[$_fetch_host]"
REPO_AUTO_UPDATE_FETCH_USER=${PTO_AUTH_PROXY_OWNER:-@PROXY_USER@}
REPO_AUTO_UPDATE_FETCH_ALL_PROXY="socks5h://${_fetch_host}:${PTO_AUTH_PROXY_UPSTREAM_PORT}"
unset _auth_config _fetch_host
REPO_AUTO_UPDATE_VERIFY=@PREFIX@/bin/pto-auth-proxy-update-verify
REPO_AUTO_UPDATE_APPLY=@PREFIX@/bin/pto-auth-proxy-update-apply
REPO_AUTO_UPDATE_LOCK_FILE=/run/lock/pto-auth-proxy-auto-update.lock
