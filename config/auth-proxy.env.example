# pto-auth-proxy 非敏感配置。密码、token 和 ~/.proxy-secret 不得写入这里。
PTO_AUTH_PROXY_OWNER=pypto
PTO_AUTH_PROXY_GROUP=proxyusers
PTO_AUTH_PROXY_PAM_SERVICE=sshd

# 默认只监听本机。不要在没有额外网络隔离时改为 0.0.0.0。
PTO_AUTH_PROXY_LISTEN_HOST=127.0.0.1
PTO_AUTH_PROXY_SOCKS_PORT=20808
PTO_AUTH_PROXY_HTTP_PORT=20809
# auto 是新终端的默认模式；未匹配代理域名的公共 HTTP(S) 请求从本机直连。
PTO_AUTH_PROXY_AUTO_SOCKS_PORT=20810
PTO_AUTH_PROXY_AUTO_HTTP_PORT=20811
# auto 入口不允许访问内网/本机；本机和内网应通过 NO_PROXY 由应用直接访问。
PTO_AUTH_PROXY_DIRECT_PORTS=80,443
# 可选 PTO_AUTH_PROXY_PROXY_DOMAINS=/absolute/path/proxy-domains.txt
# 分流规则与 whitelist.txt 独立；代理规则命中仍需通过白名单。

# 所有经 20808/20809 认证并通过白名单的业务流量都会转发到这个 SOCKS5 上游。
# 与后端实现无关：可以使用 mihomo mixed-port/SOCKS5 端口或 SSH RemoteForward。
# 必须按本机实际监听填写端口，例如 mihomo mixed-port 为 7895 时填写 7895。
# 不自动探测或回退到历史端口；空值会让 validate/run 明确报错。
# 本服务不会启动后端或创建隧道，后端应由各自的服务负责。
PTO_AUTH_PROXY_UPSTREAM_HOST=127.0.0.1
PTO_AUTH_PROXY_UPSTREAM_PORT=
# 需要阻止普通用户直连的本机上游端口；至少应包含 UPSTREAM_PORT。
# 留空时仅保护 UPSTREAM_PORT；额外端口用逗号分隔，必须包含 UPSTREAM_PORT。
PTO_AUTH_PROXY_GUARD_PORTS=

# 本机保护参数：上游异常时快速失败，避免单个连接长期挂住。
PTO_AUTH_PROXY_CLIENT_HANDSHAKE_TIMEOUT=15
PTO_AUTH_PROXY_UPSTREAM_CONNECT_TIMEOUT=5
PTO_AUTH_PROXY_UPSTREAM_HANDSHAKE_TIMEOUT=10
# 一侧关闭发送方向后，最多等待另一侧完成剩余响应的秒数。
PTO_AUTH_PROXY_RELAY_HALF_CLOSE_TIMEOUT=30
PTO_AUTH_PROXY_CLOSE_TIMEOUT=2
